# Copy to .env.local for local development, or add these in Vercel -> Project Settings -> Environment Variables.
# Never commit real values. Never prefix these with NEXT_PUBLIC_.

# Resend (https://resend.com). Create a key and verify your sending domain before going live.
RESEND_API_KEY=re_replace_me

# Who receives enquiries. Testing: a personal inbox. Production: the official Vedanova address.
CONTACT_EMAIL=vedanovachemicals@gmail.com

# Sender. Testing: onboarding@resend.dev. Production: an address on your verified domain.
RESEND_FROM_EMAIL="Vedanova Chemicals <enquiries@your-verified-domain.com>"

# Shared rate limiting (recommended on Vercel). Create an Upstash Redis database via the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical production URL, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://vedanova-chemicals.vercel.app
